#version 450

#extension GL_GOOGLE_include_directive : require

#include "bindings.glsl"
#include "buffer_references.glsl"
#include "util.glsl"

layout (local_size_x = 32, local_size_y = 32) in;

layout( push_constant ) uniform constants
{
	LuminanceAvgBuffer luminance_avg_buffer;
	vec2 screen_size;
	uint draw_id;
	uint autoexpose;
	uint tonemap_func;
};

// http://filmicworlds.com/blog/filmic-tonemapping-operators/
vec3 filmic_optimized(vec3 c)
{
	vec3 x = max(vec3(0.0), c - 0.004);
	vec3 color = (x * ( 6.2 * x + 0.5)) / (x * (6.2 * x +1.7) + 0.06);

	// already non-linear
	return color;
}

vec3 reinhard(vec3 c)
{
	return c / (vec3(1.0) + c);
}

vec3 reverse_reinhard(vec3 c)
{
    // return c / (vec3(1.0) - c);
    return c;
}

// Minimal AgX implementation: https://iolite-engine.com/blog_posts/minimal_agx_implementation
vec3 agx_default_contrast_approx(vec3 x)
{
    vec3 x2 = x * x;
    vec3 x4 = x2 * x2;

    return + 15.5     * x4 * x2
           - 40.14    * x4 * x
           + 31.96    * x4
           - 6.868    * x2 * x
           + 0.4298   * x2
           + 0.1191   * x
           - 0.00232;
}

vec3 agx(vec3 val)
{
    const mat3 agx_mat = mat3(
        0.842479062253094, 0.0423282422610123, 0.0423756549057051,
        0.0784335999999992,  0.878468636469772,  0.0784336,
        0.0792237451477643, 0.0791661274605434, 0.879142973793104
    );

    const float min_ev = -12.47393;
    const float max_ev = 4.026069;

    // input transform
    val = agx_mat * val;

    // log2 space encoding
    val = clamp(log2(val), min_ev, max_ev);
    val = (val - min_ev) / (max_ev - min_ev);

    // apply sigmoid function approximation
    val = agx_default_contrast_approx(val);

    return val;
}

vec3 agx_eotf(vec3 val)
{
    const mat3 agx_mat_inv = mat3(
        1.19687900512017, -0.0528968517574562, -0.0529716355144438,
        -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
        -0.0990297440797205, -0.0989611768448433, 1.15107367264116
    );

    // inverse input transform
    val = agx_mat_inv * val;

    // if RT is linear and swapchain is SRGB, uncomment
    // val = pow(val, vec3(2.2));

    return val;
}

void main()
{
	ivec2 texel_coord = ivec2(gl_GlobalInvocationID.xy);

	if (texel_coord.x < screen_size.x && texel_coord.y < screen_size.y)
	{
		vec3 color = imageLoad(images_rgba32f[draw_id], texel_coord).rgb;

		float exposure = 1.0;

		// automatic exposure, see eq. 112: https://google.github.io/filament/Filament.md.html#imagingpipeline/physicallybasedcamera/automaticexposure
		// also, https://bruop.github.io/exposure/
		if (autoexpose == 1.0)
		{
			float Lavg = luminance_avg_buffer.luminance_avg;
			float Lmax = 9.6 * Lavg;
			exposure = 1.0 / Lmax;
		}

		color.xyz *= exposure;

		switch (tonemap_func)
		{
			case 0:
			    color.xyz = agx(color.xyz);
				color.xyz = agx_eotf(color.xyz);
				break;
			case 1: color.xyz = linear_to_srgb(reinhard(color.xyz)); break;
			case 2: color.xyz = filmic_optimized(color.xyz); break;
			case 3: color.xyz = linear_to_srgb(color.xyz); break; // OETF -> clamp
			default: break; // clamp only
		}

		imageStore(images_rgba32f[draw_id], texel_coord, vec4(color, 1.0));
	}
}
