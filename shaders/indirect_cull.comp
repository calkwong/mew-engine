#version 450

#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference : require

layout (local_size_x = 256) in;

struct ObjectData
{
	mat4 worldMatrix;
	vec3 origin;
	float radius;
	uint materialID;
	//vec3 extent;
	uint padding[3];
};

layout(buffer_reference, std430) readonly buffer ObjectBuffer
{ 
	ObjectData objects[];
};

struct GPUInstance
{
	uint object_id;
	uint batch_id;
};

layout(buffer_reference, std430) readonly buffer gInstanceBuffer
{ 
	GPUInstance instances[];
};

struct DrawCommand
{
	uint index_count;
	uint instance_count;
	uint first_index;
	int vertex_offset;
	uint first_instance;
};

layout(buffer_reference, std430) buffer DrawCommandsBuffer
{ 
	DrawCommand commands[];
};

layout(buffer_reference, std430) buffer CountBuffer
{
	uint count[];
};
	
layout(buffer_reference, std430) buffer VisibilityBuffer
{
	uint visible[];
};

layout(buffer_reference, std430) buffer DebugBuffer
{
	float value[];
};
	
layout(push_constant) uniform constants
{
	vec4 frustum_planes[6];
	mat4 viewProj;
	ObjectBuffer objectBuffer;
	DrawCommandsBuffer clearBuffer;
	DrawCommandsBuffer drawBuffer;
	CountBuffer countBuffer;
	VisibilityBuffer visBuffer;
	DebugBuffer debugBuffer;
	uint count;
	uint late;
	uint texture_id;
	uint occlusionEnabled;
} pc;

layout(set = 0, binding = 0, r32f) uniform image2D allImages[];
layout(set = 1, binding = 0) uniform texture2D allTextures[];
layout(set = 2, binding = 0) uniform sampler samplers[];

bool frustumCulled(uint object_id, uint id)
{
	ObjectData obj = pc.objectBuffer.objects[object_id];
	vec3 center = vec3(obj.worldMatrix * vec4(obj.origin, 1.0));
	float radius = obj.radius;
	
	vec3 right = vec3(obj.worldMatrix[0]);
	vec3 up = vec3(obj.worldMatrix[1]);
	vec3 forward = vec3(obj.worldMatrix[2]);
	
	vec3 scale = vec3(length(right), length(up), length(forward));
	
	float maxScale = max(scale.z, max(scale.x, scale.y));
	radius = radius * maxScale;
	pc.debugBuffer.value[id] = radius;
	
	bool visible;
	
	for (uint i = 0; i < 6; i++)
	{
		vec3 normal = pc.frustum_planes[i].xyz;
		float distance = pc.frustum_planes[i].w;
			
		// project radius (extent) of box onto line
		float r = radius;
		// distance of box center from plane
		float s = dot(center, normal) + distance;
		
		visible = visible && (s >= -r);
	}
	
	return !visible;
}

