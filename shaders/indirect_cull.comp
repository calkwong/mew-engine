void main()
{
	uint id = gl_GlobalInvocationID.x;
	
	
	if (id < pc.count)
	{
		bool late = pc.late == 1;
		bool visible_last_frame = pc.visBuffer.visible[id] == 1;
		
		if (!late && !visible_last_frame)
			return;
		
		DrawCommand command = pc.clearBuffer.commands[id];
		
		uint object = command.first_instance;
		
		pc.debugBuffer.value[id] = 99; 
		bool visible = !frustumCulled(object, id);
		
		
		bool shouldDraw = false;
		if (!late)
			shouldDraw = visible;
		else
		{
			if (visible)
			{
				if (pc.occlusionEnabled == 1)
					visible = visible; // && !occlusionCulled(object, id);
				shouldDraw = visible && !visible_last_frame;
			}
		}
		
		if (shouldDraw)
		{
			uint count = atomicAdd(pc.countBuffer.count[0], 1);
			
			pc.drawBuffer.commands[count].index_count = command.index_count;
			pc.drawBuffer.commands[count].instance_count = 1;
			pc.drawBuffer.commands[count].first_index = command.first_index;
			pc.drawBuffer.commands[count].vertex_offset = command.vertex_offset;
			pc.drawBuffer.commands[count].first_instance = command.first_instance;
		}
		
		if (late)
			pc.visBuffer.visible[id] = uint(visible); 

	}
}