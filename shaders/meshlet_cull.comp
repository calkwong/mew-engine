#version 450

#extension GL_GOOGLE_include_directive : require

#include "bindings.glsl"
#include "buffer_references.glsl"

layout (local_size_x = 32) in;

layout(push_constant) uniform constants
{
	mat4 view;
	vec4 frustumPlanes;
	
	ObjectBuffer objectBuffer;
	MeshletBuffer meshletBuffer;
	ClusterIndicesBuffer clusterIndicesBuffer;
	ClusterCountBuffer clusterCountBuffer; 
	VisibilityBuffer meshletVisBuffer; // meshletVisibilityBuffer
	MeshTaskBuffer meshTaskBuffer;
	
	uint count; // unused?
	uint late;
	uint textureId;
	uint occlusionEnabled;
	
	float p00;
	float p11;
	float znear;
	float zfar; // this is draw distance
	
	vec2 resolution;
	float textureLod;
	float lodDistanceFactor;
	uint lodEnabled;
	uint taskSubmit;
	uint postPass;
} pc;

// 2D Polyhedral Bounds of a Clipped, Perspective-Projected 3D Sphere. Michael Mara, Morgan McGuire. 2013
// https://zeux.io/2023/01/12/approximate-projected-bounds/
bool projectSphere(vec3 c, float r, float znear, float P00, float P11, out vec4 aabb)
{
	if (c.z < r + znear)
		return false;

    vec3 cr = c * r;
    float czr2 = c.z * c.z - r * r;

    float vx = sqrt(c.x * c.x + czr2);
    float minx = (vx * c.x - cr.z) / (vx * c.z + cr.x);
    float maxx = (vx * c.x + cr.z) / (vx * c.z - cr.x);

    float vy = sqrt(c.y * c.y + czr2);
    float miny = (vy * c.y - cr.z) / (vy * c.z + cr.y);
    float maxy = (vy * c.y + cr.z) / (vy * c.z - cr.y);

    aabb = vec4(minx * P00, miny * P11, maxx * P00, maxy * P11);
    // clip space -> uv space
    aabb = aabb.xwzy * vec4(0.5f, -0.5f, 0.5f, -0.5f) + vec4(0.5f);

    return true;
}

bool frustumCulled(vec3 center, float radius)
{
	bool visible = true;
	
	// symmetrical sphere-plane distance test
	visible = visible && (center.z * pc.frustumPlanes.y - abs(center.x) * pc.frustumPlanes.x) >= -radius;
	visible = visible && (center.z * pc.frustumPlanes.w - abs(center.y) * pc.frustumPlanes.z) >= -radius;
	visible = visible && (center.z - radius <= -pc.znear) && (center.z + radius >= -pc.zfar);	
		
	return !visible;
}

bool occlusionCulled(vec3 center, float radius)
{
	vec4 aabb;
	
	if (projectSphere(vec3(center.x, center.y, -center.z), radius, pc.znear, pc.p00, pc.p11, aabb))
	{
		vec2 pixelSize = (aabb.zw - aabb.xy) * pc.resolution; 
		
		float max_dim = max(pixelSize.x, pixelSize.y);
		
		float mip = ceil(log2(max_dim));
		mip = min(mip, pc.textureLod); // TODO: PC
		
		float depth = textureLod(sampler2D(textures[pc.textureId], samplers[DEPTH_REDUCTION_SAMPLER]), (aabb.zw + aabb.xy) * 0.5, mip).r;
		
		float depthSphere = pc.znear / (-center.z - radius); 
		return depthSphere < depth; // reverse depth
	}
}

void main()
{
	uint id = gl_WorkGroupID.x; // 0 - workgroupX-1
	uint ti = gl_LocalInvocationIndex; // 0 - 31

	// TODO: inspired by https://github.com/expenses/lighthugger/blob/main/src/shaders/common/prefix_sum.glsl
	// - read mesh_cull TODO first
	// - id no longer indexes into meshTask, but used as binary search to get correct PrefixSumValue
	// - meshlet_id from binary search for indexing into meshlet buffer should add meshletOffset to account for LODs?
	// - result from binary search needs to be adjusted for LOD meshlet offset for correct indexing of meshlet buffer
	// - yet to figure out how clusterIndices will change. 
	//     - could compute inclusiveSum value for a specific meshlet as the index, at the cost of binary searching all over again in mesh shader
	// - in a perfect world, task shader is efficient and we can forget storing all these intermediate buffers
	
	uint meshletOffset = pc.meshTaskBuffer.commands[id].meshletOffset + ti;
	uint objectId = pc.meshTaskBuffer.commands[id].objectId;
	uint meshletVisibilityOffset = pc.meshTaskBuffer.commands[id].meshletVisibilityOffset + ti;
	uint meshletCount = pc.meshTaskBuffer.commands[id].meshletCount; 
	
	if (ti < meshletCount)
	{
		bool late = pc.late == 1;
		
		// bit shift in place of floor division, then bit& to extract the relevant bit
		uint meshletVisibilityBit = pc.meshletVisBuffer.visible[meshletVisibilityOffset >> 5] & (1u << (meshletVisibilityOffset & 31));
		
		bool visibleLastFrame = meshletVisibilityBit != 0; 
		
		if (!late && !visibleLastFrame)
			return;
		
		bool skip = false; // always false for early pass
		if (late && visibleLastFrame) 
			skip = true;
		if (pc.postPass != 0) // culling mask and transparent regardless of visibility last frame as its a single cull pass
			skip = false;
			
		// reprocess all meshlets of visible meshes	
		Meshlet meshlet = pc.meshletBuffer.meshlets[meshletOffset]; 
		
		ObjectData obj = pc.objectBuffer.objects[objectId];
	
		vec3 center = vec3(pc.view * obj.worldMatrix * vec4(meshlet.cx, meshlet.cy, meshlet.cz, 1.0));
		float radius = meshlet.radius;
		
		vec3 right = vec3(obj.worldMatrix[0]);
		vec3 up = vec3(obj.worldMatrix[1]);
		vec3 forward = vec3(obj.worldMatrix[2]);
		
		vec3 scale = vec3(length(right), length(up), length(forward));
		
		float maxScale = max(scale.z, max(scale.x, scale.y));
		radius = radius * maxScale;
		
		// frustum culling
		bool visible = !frustumCulled(center, radius);
		
		if (late && visible)
		{
			if (pc.occlusionEnabled == 1)
				visible = visible && !occlusionCulled(center, radius);
		}
		
		// render or not - both pass 1 & 2
		if (visible && !skip)
		{
			uint clusterIndex = atomicAdd(pc.clusterCountBuffer.workgroupX, 1);
			pc.clusterCountBuffer.workgroupY = 1;
			pc.clusterCountBuffer.workgroupZ = 1;
			
			pc.clusterIndicesBuffer.indices[clusterIndex] = id | (ti << 27); // no error checking yet
		}
		
		if (late) // can we skip this for masked geometry? 
		{
			// TODO: use subgroups and update from a single thread, potentially need to update 2 uints
			if (visible)
				atomicOr(pc.meshletVisBuffer.visible[meshletVisibilityOffset >> 5], 1u << (meshletVisibilityOffset & 31));
			else
				atomicAnd(pc.meshletVisBuffer.visible[meshletVisibilityOffset >> 5], ~(1u << (meshletVisibilityOffset & 31)));
		}
	}
}